     return {k: v for k, v in jsdata.items() if k in _ADMIN_USER_WRITABLE_FIELDS}
 
 
+
+_APPROVED_TENANT_ROLE_NAMES = {
+    "SOC Viewer",
+    "SOC Auditor",
+    "SOC L1",
+    "SOC L2",
+    "SOC L3",
+    "SOC Admin",
+}
+
+
+def _get_approved_tenant_role_groups():
+    return Group.query.filter(
+        Group.group_name.in_(
+            _APPROVED_TENANT_ROLE_NAMES
+        )
+    ).order_by(
+        Group.group_name
+    ).all()
+
+
+def _tenant_admin_can_assign_groups(group_ids):
+    if ac_current_user_has_permission(
+        Permissions.server_administrator
+    ):
+        return True
+
+    try:
+        requested_ids = {
+            int(group_id)
+            for group_id in group_ids
+        }
+    except (TypeError, ValueError):
+        return False
+
+    if not requested_ids:
+        return False
+
+    groups = Group.query.filter(
+        Group.group_id.in_(requested_ids)
+    ).all()
+
+    if len(groups) != len(requested_ids):
+        return False
+
+    for group in groups:
+
+        if group.group_name not in _APPROVED_TENANT_ROLE_NAMES:
+            return False
+
+        # Defense in depth: even if an approved role were accidentally
+        # modified, a tenant administrator must never assign a role
+        # carrying platform-global permissions.
+        if (
+            group.group_permissions
+            & Permissions.server_administrator.value
+        ):
+            return False
+
+        if (
+            group.group_permissions
+            & Permissions.platform_tenants_manage.value
+        ):
+            return False
+
+    return True
+
+
+_TENANT_USER_WRITABLE_FIELDS = {
+    'csrf_token',
+    'user_id',
+    'user_name',
+    'user_login',
+    'user_email',
+    'user_password',
+    'active',
+}
+
+
+def _filter_tenant_user_payload(jsdata):
+    """
+    Tenant administrators may manage ordinary human-user fields only.
+
+    Platform-only fields such as service-account status, organisation,
+    role strings and administrative flags are deliberately excluded.
+    """
+    if not isinstance(jsdata, dict):
+        return {}
+
+    return {
+        k: v for k, v in jsdata.items()
+        if k in _TENANT_USER_WRITABLE_FIELDS
+    }
+
+
+def _current_user_client_ids():
+    return {
+        row[0]
+        for row in UserClient.query.with_entities(
+            UserClient.client_id
+        ).filter(
+            UserClient.user_id == current_user.id
+        ).all()
+    }
+
+
+def _target_user_client_ids(user_id):
+    return {
+        row[0]
+        for row in UserClient.query.with_entities(
+            UserClient.client_id
+        ).filter(
+            UserClient.user_id == user_id
+        ).all()
+    }
+
+
+def _tenant_admin_can_manage_user(user_id):
+    """
+    Tenant administrators may manage only ordinary SOC users completely
+    contained inside their own tenant scope.
+
+    Platform administrators, service accounts, global-role users and
+    shared cross-tenant provider users remain protected.
+    """
+    if ac_current_user_has_permission(Permissions.server_administrator):
+        return True
+
+    target_user = get_user(user_id)
+
+    if not target_user:
+        return False
+
+    # Service-account lifecycle remains Platform Admin controlled.
+    if target_user.is_service_account:
+        return False
+
+    manager_clients = _current_user_client_ids()
+    target_clients = _target_user_client_ids(user_id)
+
+    if not manager_clients or not target_clients:
+        return False
+
+    if not target_clients.issubset(manager_clients):
+        return False
+
+    target_groups = Group.query.join(
+        UserGroup,
+        UserGroup.group_id == Group.group_id
+    ).filter(
+        UserGroup.user_id == user_id
+    ).all()
+
+    for group in target_groups:
+
+        # Tenant administrators may not manipulate legacy/global or
+        # custom-role accounts.
+        if group.group_name not in _APPROVED_TENANT_ROLE_NAMES:
+            return False
+
+        if (
+            group.group_permissions
+            & Permissions.server_administrator.value
+        ):
+            return False
+
+        if (
+            group.group_permissions
+            & Permissions.platform_tenants_manage.value
+        ):
+            return False
+
+    return True
+
+
+def _tenant_admin_can_assign_customers(customer_ids):
+    if ac_current_user_has_permission(Permissions.server_administrator):
+        return True
+
+    try:
+        requested = {int(client_id) for client_id in customer_ids}
+    except (TypeError, ValueError):
+        return False
+
+    if not requested:
+        return False
+
+    return requested.issubset(_current_user_client_ids())
+
+
+def _tenant_user_access_denied():
+    return response_error(
+        "User is outside your tenant administration scope",
+        status=403
+    )
+
+
